      <tns:Transport tns:transportId="{{transportId}}">
         <tns:TransportSender>
            <tns:TransportProtocol tns:version="1.1">HTTP</tns:TransportProtocol>
         </tns:TransportSender>
         <tns:TransportReceiver>
            <tns:TransportProtocol tns:version="1.1">HTTP</tns:TransportProtocol>
            <tns:Endpoint tns:uri="{{uri}}"/>
                          tns:type="allPurpose"/>
         </tns:TransportReceiver>
      </tns:Transport>